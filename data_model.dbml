table admins {
  id uuid [primary key]
  email text [not null, unique]
  first_name text [not null]
  last_name text [not null]
  is_super_admin boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (email, last_name, first_name) [name: 'admins_trigram_idx', note: 'GIN gin_trgm_ops']
    (first_name, last_name) [name: 'admins_name_idx']
    created_at [name: 'admins_created_at_idx']
  }
}

table users {
  id uuid [primary key]
  email text [not null, unique]
  first_name text [not null]
  last_name text [not null]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (email, last_name, first_name) [name: 'users_trigram_idx', note: 'GIN gin_trgm_ops']
    (first_name, last_name) [name: 'users_name_idx']
    created_at [name: 'users_created_at_idx']
  }
}
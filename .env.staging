BASE_SUPABASE_URL=
BASE_SUPABASE_PUBLISHABLE_KEY=

# .env.development
# Native (Expo + React Native)
EXPO_PUBLIC_SUPABASE_URL=$BASE_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=$BASE_SUPABASE_PUBLISHABLE_KEY
EXPO_PUBLIC_ENVIRONMENT="production"
EXPO_PUBLIC_SENTRY_DSN=

# Admin (Vite + React)
VITE_ENVIRONMENT="production"
VITE_SUPABASE_URL=$BASE_SUPABASE_URL
VITE_SUPABASE_PUBLISHABLE_KEY=$BASE_SUPABASE_PUBLISHABLE_KEY
VITE_SENTRY_DSN=

# Admin (Vite + React)
VITE_ENVIRONMENT="staging"
VITE_SUPABASE_URL=$BASE_SUPABASE_URL
VITE_SUPABASE_PUBLISHABLE_KEY=$BASE_SUPABASE_PUBLISHABLE_KEY
VITE_SENTRY_DSN=

# Supabase
SB_ENVIRONMENT="staging"
SB_PROJECT_ID=
SB_DB_PASSWORD=
SB_DB_CONNECTION_STRING=
SB_SENTRY_DSN=

# Supabase Vault
VAULT_SB_URL=$BASE_SUPABASE_URL
VAULT_SB_PUBLISHABLE_KEY=$BASE_SUPABASE_PUBLISHABLE_KEY
VAULT_SB_SECRET_KEY=